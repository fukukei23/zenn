#!/usr/bin/env bash
# pre-commit — 層1（suiko）最小hook（Phase 0項目④・2026-09-24・昇格済み運用）
# 仕様: 警告のみ・3秒タイムアウト・非block（常にexit 0）
#  - suiko不在・タイムアウト・エラーは全て黙ってスキップ（コミットを止めない）
#  - 昇格済み: 2検出器（redundant_light_verb / hype_expression）のみ表示
#    （筆者6/6+他者9/11で誤検知率9.1%・Wilson上限27.0%≤30%で昇格承認 2026-09-25）
#  - 表示はinfo相当の参考提示（warn扱いしない・r2 GLM#5採用）
set -u

SUIKO="${SUIKO_BIN:-$HOME/bin/suiko}"
FILTER="$(dirname "$0")/../scripts/phase0/filter_suiko_warn.py"

# コミット対象のarticles配下mdのみ対象
targets=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '^articles/.*\.md$' || true)
[ -z "$targets" ] && exit 0

for f in $targets; do
    [ -f "$f" ] || continue
    out=$(timeout 3 "$SUIKO" lint --genre tech --json "$f" 2>/dev/null) || continue
    warns=$(printf '%s' "$out" | timeout 3 python3 "$FILTER" 2>/dev/null) || continue
    if [ -n "$warns" ]; then
        echo "⚠️ [層1 suiko・参考] $f:"
        printf '%s\n' "$warns"
        echo ""
    fi
done
exit 0
